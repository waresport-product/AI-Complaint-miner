# Copy to .env and fill in. Never commit .env.

# Web search + scraping (review sites, forums)
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key

# Analyst LLM: OpenAI (default)
OPENAI_API_KEY=sk-your_openai_api_key
COMPLAINT_MINER_LLM_PROVIDER=openai
# COMPLAINT_MINER_MODEL=gpt-4o-mini

# Optional fallback: Gemini is only used if COMPLAINT_MINER_LLM_PROVIDER=gemini
# or no OPENAI_API_KEY is set.
# GEMINI_API_KEY=your_gemini_api_key

# Optional overrides
# COMPLAINT_MINER_MAX_AGE_DAYS=730
# COMPLAINT_MINER_OUTPUT_DIR=output/complaint-miner
# COMPLAINT_MINER_CRON=0 8 * * 1,4
# COMPLAINT_MINER_LLM_CONCURRENCY=3
# AGENT_REACH_BIN=agent-reach
