# Copy to .env and fill in. Never commit .env.

# Web search + scraping (review sites, forums)
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key

# Analyst LLM: OpenAI (default)
OPENAI_API_KEY=sk-your_openai_api_key
COMPLAINT_MINER_LLM_PROVIDER=openai
# COMPLAINT_MINER_MODEL=gpt-4o-mini

# Optional fallback: Gemini is only used if COMPLAINT_MINER_LLM_PROVIDER=gemini
# or no OPENAI_API_KEY is set.
# GEMINI_API_KEY=your_gemini_api_key

# CRM-ready alerts (optional): POST new alerts to a Slack/Teams incoming webhook, or to a
# Zapier/Make/HubSpot workflow URL. Without it, alerts are kept in output/.../alerts.json.
# COMPLAINT_MINER_WEBHOOK_URL=https://hooks.slack.com/services/...

# Insights API for the website (npm run api)
# COMPLAINT_MINER_API_PORT=8787
# COMPLAINT_MINER_API_HOST=127.0.0.1          # 0.0.0.0 to expose beyond this machine
# COMPLAINT_MINER_API_TOKEN=change-me          # required by clients as "Authorization: Bearer <token>"
# COMPLAINT_MINER_API_CORS_ORIGIN=https://www.waresport.com

# Optional overrides
# COMPLAINT_MINER_MAX_AGE_DAYS=730
# COMPLAINT_MINER_OUTPUT_DIR=output/complaint-miner
# COMPLAINT_MINER_CRON=0 8 * * 1,4
# COMPLAINT_MINER_LLM_CONCURRENCY=3
# AGENT_REACH_BIN=agent-reach
