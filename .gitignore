# ── Secrets ─────────────────────────────────────────────
# API keys live in .env (copy .env.example). Never commit them.
.env
.env.*
!.env.example

# ── Dependencies ────────────────────────────────────────
node_modules/

# ── Run output ──────────────────────────────────────────
# Scraped data, run state (state.json / complaints.json) and Excel workbooks.
# These contain third-party content and are regenerated by running the miner.
output/
*.xlsx
~$*.xlsx

# ── Logs & test artifacts ───────────────────────────────
*.log
npm-debug.log*
coverage/

# ── OS / editor files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
